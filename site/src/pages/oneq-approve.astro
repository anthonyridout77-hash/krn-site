---
/* Approval page for the One-Question Consult plan (Kat only).
   Linked from the approval email as /oneq-approve/?c=<appointment key>&t=<token>&v=<document version>
   Loads nothing from the network on open. Shows what the URL says (key, version) and a
   Drive link to the PDF (?p=<drive file id>, optional). Approve / Request changes POST to the
   Make webhook "KRN OneQ Approval"; a GET to that webhook does nothing. Not indexed, not cached. */
import Base from '../layouts/Base.astro';
import '../styles/article.css';
---
<Base title="Approve a consult summary | Katrina Ridout Nutrition" description="Internal approval page for One-Question Consult plans." noindex={true}>
  <Fragment slot="head">
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta name="referrer" content="no-referrer">
  </Fragment>
  <section class="nf">
    <div class="wrap" style="max-width:40rem">
      <p class="eyebrow">One-Question Consult</p>
      <h1>Approve this plan?</h1>
      <p id="apMissing" class="err" role="alert">This link is incomplete. Open the latest approval email and use the button there.</p>
      <div id="apBody" hidden>
        <p>Read the PDF first. Approving sends this exact version to the client by email and records your approval against the appointment. Nothing is sent until you confirm below.</p>
        <dl style="display:grid;grid-template-columns:max-content 1fr;gap:.4rem 1.2rem;margin:1.5rem 0">
          <dt>Client</dt><dd id="apClient">see approval email</dd>
          <dt>Appointment</dt><dd><code id="apKey"></code></dd>
          <dt>Document version</dt><dd><code id="apVersion"></code></dd>
          <dt>Plan PDF</dt><dd><a id="apPdf" href="#" target="_blank" rel="noopener noreferrer">Open the PDF in Drive</a><span id="apNoPdf" hidden>Use the Drive link in the approval email.</span></dd>
        </dl>
        <form id="apForm" method="post" novalidate style="display:grid;gap:1rem">
          <input type="hidden" name="c" id="apC"><input type="hidden" name="t" id="apT"><input type="hidden" name="v" id="apV"><input type="hidden" name="action" id="apAction"><input type="hidden" name="confirm" value="yes">
          <label><input type="checkbox" id="apRead" required> I have read this version of the PDF and I am happy for the client to receive it.</label>
          <div>
            <label for="apNotes">If requesting changes, what should change? (sent to Anthony and the plan agent; no client details needed)</label>
            <textarea id="apNotes" name="notes" rows="3" maxlength="1500"></textarea>
          </div>
          <div style="display:flex;gap:1rem;flex-wrap:wrap">
            <button class="btn btn-coral" type="button" id="apApprove">Approve and send</button>
            <button class="btn btn-line" type="button" id="apChanges">Request changes</button>
          </div>
          <p class="ok" id="apOk" role="status" aria-live="polite"></p>
          <p class="err" id="apErr" role="alert"></p>
        </form>
        <small>This page keeps nothing and loads nothing. If you are not Katrina Ridout, close it.</small>
      </div>
    </div>
  </section>
</Base>
<script is:inline>
(function(){
  var ENDPOINT='https://hook.eu1.make.com/t1f996x7tjfbbyiiaxpdlmrmrp7b8bv7';
  var p=new URLSearchParams(location.search);
  var c=(p.get('c')||'').replace(/[^a-f0-9]/gi,''), t=(p.get('t')||'').replace(/[^a-f0-9]/gi,''), v=(p.get('v')||'').replace(/[^a-z0-9.-]/gi,''), pdf=(p.get('p')||'').replace(/[^A-Za-z0-9_-]/g,''), ini=(p.get('i')||'').replace(/[^A-Za-z]/g,'').slice(0,3).toUpperCase();
  if(!c||!t||!v){document.getElementById('apMissing').classList.add('show');return;}
  document.getElementById('apBody').hidden=false;
  document.getElementById('apKey').textContent=c; document.getElementById('apVersion').textContent=v;
  document.getElementById('apC').value=c; document.getElementById('apT').value=t; document.getElementById('apV').value=v;
  if(ini)document.getElementById('apClient').textContent='initials '+ini;
  var a=document.getElementById('apPdf');
  if(pdf){a.href='https://drive.google.com/file/d/'+pdf+'/view';}else{a.hidden=true;document.getElementById('apNoPdf').hidden=false;}
  var f=document.getElementById('apForm'), okEl=document.getElementById('apOk'), errEl=document.getElementById('apErr');
  function send(action){
    okEl.classList.remove('show');errEl.classList.remove('show');
    if(!document.getElementById('apRead').checked){errEl.textContent='Tick the box to confirm you have read this version.';errEl.classList.add('show');return;}
    if(action==='changes'&&!document.getElementById('apNotes').value.trim()){errEl.textContent='Say briefly what should change.';errEl.classList.add('show');return;}
    if(action==='approve'&&!window.confirm('Send document version '+v+' to the client now?'))return;
    document.getElementById('apAction').value=action;
    var btns=f.querySelectorAll('button');[].forEach.call(btns,function(b){b.disabled=true;});
    var data={action:action,c:c,t:t,v:v,confirm:'yes',notes:document.getElementById('apNotes').value.trim()};
    fetch(ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)})
      .then(function(r){
        if(r.status===200){okEl.textContent=action==='approve'?'Approved. Version '+v+' has been sent to the client and recorded.':'Held. Changes requested; a new version will come back to you for approval.';okEl.classList.add('show');return;}
        if(r.status===409){errEl.textContent='Not sent: this is an older version, or the plan is not awaiting approval. Open the latest approval email.';}
        else{errEl.textContent='Not accepted ('+r.status+'). Nothing was sent. Reply to the approval email instead.';}
        errEl.classList.add('show');[].forEach.call(btns,function(b){b.disabled=false;});
      })
      .catch(function(){
        /* Cross-origin fetch blocked: fall back to a plain form POST; the webhook answers with a page. */
        f.action=ENDPOINT; f.submit();
      });
  }
  document.getElementById('apApprove').addEventListener('click',function(){send('approve');});
  document.getElementById('apChanges').addEventListener('click',function(){send('changes');});
})();
</script>
