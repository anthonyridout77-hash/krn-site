</script>
<script is:inline slot="after">
(function(){
  var h=document.getElementById('heroH1'),p=document.getElementById('heroLede'),box=document.getElementById('heroRotator');
  if(!h||!p||!box)return;
  var slides;try{slides=JSON.parse(document.getElementById('heroSlides').textContent);}catch(e){return;}
  var tabs=[].slice.call(box.querySelectorAll('[role=tab]')),i=0,timer=null,user=false,hover=false;
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var INTERVAL=5500,FADE=reduce?0:260;
  function render(n){var s=slides[n];h.textContent='';h.appendChild(document.createTextNode(s.h+' '));var sp=document.createElement('span');sp.className='hl';sp.textContent=s.hl;h.appendChild(sp);p.textContent=s.p;}
  function sizeLock(){var mh=0,mp=0;var cur=i;for(var k=0;k<slides.length;k++){render(k);mh=Math.max(mh,h.offsetHeight);mp=Math.max(mp,p.offsetHeight);}render(cur);h.style.minHeight=mh+'px';p.style.minHeight=mp+'px';}
  function go(n,fromUser){n=(n+slides.length)%slides.length;if(n===i&&fromUser)return;box.classList.add('swap');
    setTimeout(function(){i=n;render(i);tabs.forEach(function(t,k){t.setAttribute('aria-selected',k===i?'true':'false');});var seg=tabs[i].parentNode;if(seg.scrollWidth>seg.clientWidth){seg.scrollTo({left:Math.max(0,tabs[i].offsetLeft-12),behavior:reduce?'auto':'smooth'});}box.classList.remove('swap');},FADE);
    if(fromUser){user=true;stop();window.dataLayer=window.dataLayer||[];window.dataLayer.push({event:'hero_segment',segment:tabs[n].textContent.trim()});}}
  function tick(){if(!hover&&!document.hidden)go(i+1,false);}
  function start(){if(reduce||user||timer)return;timer=setInterval(tick,INTERVAL);}
  function stop(){if(timer){clearInterval(timer);timer=null;}}
  tabs.forEach(function(t){t.addEventListener('click',function(){go(+t.getAttribute('data-i'),true);});});
  box.addEventListener('mouseenter',function(){hover=true;});box.addEventListener('mouseleave',function(){hover=false;});
  box.addEventListener('focusin',function(){hover=true;});box.addEventListener('focusout',function(){hover=false;});
  document.addEventListener('visibilitychange',function(){if(document.hidden)stop();else start();});
  var rt;window.addEventListener('resize',function(){clearTimeout(rt);rt=setTimeout(sizeLock,150);});
  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(sizeLock);else sizeLock();
  start();
})();
</script>
</Base>
