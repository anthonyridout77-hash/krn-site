---
import Base from '../layouts/Base.astro';
import BookBar from '../components/BookBar.astro';
---
<Base title="Fertility, Pregnancy & Postpartum Dietitian Brisbane | Katrina Ridout Nutrition" description="Evidence-based, personalised nutrition through preconception, IVF, pregnancy and postpartum from Katrina Ridout, Accredited Practising Dietitian. Milton, Brisbane and telehealth Australia-wide.">
<Fragment slot="head">
</Fragment>
<section class="hero">
  <div class="wrap">
    <div class="hero-copy">
      <p class="eyebrow fade-up" style="animation-delay:.05s">Fertility &amp; pregnancy dietitian · Brisbane &amp; Australia-wide</p>
      <div class="hero-rotator" id="heroRotator">
        <div class="seg fade-up" role="tablist" aria-label="Choose your situation" style="animation-delay:.1s">
          <button type="button" role="tab" aria-selected="true" data-i="0">All stages</button>
          <button type="button" role="tab" aria-selected="false" data-i="1">Trying</button>
          <button type="button" role="tab" aria-selected="false" data-i="2">IVF</button>
          <button type="button" role="tab" aria-selected="false" data-i="3">Pregnant</button>
          <button type="button" role="tab" aria-selected="false" data-i="4">After birth</button>
          <button type="button" role="tab" aria-selected="false" data-i="5">PMOS &amp; hormones</button>
          <button type="button" role="tab" aria-selected="false" data-i="6">Everyday</button>
        </div>
        <h1 id="heroH1" aria-label="Nutrition for trying to conceive, IVF, pregnancy and the first year after birth.">Nutrition for trying, IVF, pregnancy and <span class="hl">after.</span></h1>
        <p class="lede fade-up" id="heroLede">Trying to conceive, going through IVF, pregnant or in the first year with your baby: a clear, evidence-based plan that fits your life.</p>
        <script type="application/json" id="heroSlides">[
          {"h":"Nutrition for trying, IVF, pregnancy and","hl":"after.","p":"Trying to conceive, going through IVF, pregnant or in the first year with your baby: a clear, evidence-based plan that fits your life."},
          {"h":"Eat well for the baby you are","hl":"hoping for.","p":"Three to six months of preparation for you and your partner, built around real food and real life."},
          {"h":"Support for every","hl":"IVF cycle.","p":"Practical, evidence-based food guidance before, during and between cycles, so it is one less thing to work out alone."},
          {"h":"Calm, clear nutrition for every","hl":"trimester.","p":"Nausea, aversions, supplements and gestational diabetes, handled one step at a time."},
          {"h":"Food that fits the first year with","hl":"your baby.","p":"Recovery, breastfeeding, energy when sleep is short, and starting solids when bub is ready."},
          {"h":"PMOS and hormones,","hl":"made practical.","p":"Evidence-based nutrition for PMOS (PCOS), endometriosis and hormone health, whether or not a baby is on your mind yet."},
          {"h":"Everyday nutrition,","hl":"done properly.","p":"Not planning or pregnant? Kat sees general nutrition clients too, in Milton or by telehealth."}
        ]</script>
      </div>
      <div class="cta-row fade-up" style="animation-delay:.5s">
        <a class="btn btn-coral" href="https://calendly.com/katridout/15-minute-investigative-callback">Book a free call</a>
        <a class="btn btn-line" href="#checklist">Get the free checklist</a>
      </div>
      <p class="sub fade-up" style="animation-delay:.58s"><b>Free call:</b> 15 minutes to tell Kat what is going on and hear how she can help. <b>One-Question Consult:</b> one answer and a one-page plan. <b>Full consult:</b> complete assessment and ongoing support. <a href="#compare">Compare</a></p>
      <div class="trust fade-up" style="animation-delay:.65s">
        <span><span class="stars">★★★★★</span> <b>4.9</b> on Google · 49 reviews</span>
        <span><img class="apd" src="/images/apd-logo.webp" alt="Accredited Practising Dietitian" width="127" height="126" loading="lazy"> Dietitians Australia</span>
        <span>Medicare rebates may apply</span>
      </div>
    </div>
    <div class="hero-photo">
      <div class="panel"></div>
      <img src="/images/kat-ridout-apd.jpg" alt="Katrina Ridout, Accredited Practising Dietitian" width="480" height="480" fetchpriority="high" decoding="async">
      <div class="tag"><b>Katrina Ridout</b><small>Accredited Practising Dietitian</small></div>
    </div>
  </div>
</section>

<div class="ticker"><div class="track">
  <span>Preconception</span><i>•</i><span>IVF support</span><i>•</i><span>PCOS</span><i>•</i><span>Endometriosis</span><i>•</i><span>Gestational diabetes</span><i>•</i><span>Pregnancy</span><i>•</i><span>Postpartum</span><i>•</i><span>Breastfeeding</span></div></div>

<section class="compare" id="compare">
  <div class="wrap">
    <p class="eyebrow rv">Which one is right for you?</p>
    <h2 class="rv d1">Three ways to work with Kat</h2>
    <div class="cmp">
      <article class="cmp-card rv d1">
        <h3>Free call</h3>
        <p class="cmp-price">Free <small>15 minutes, phone</small></p>
        <ul>
          <li>Kat calls you at a time you pick</li>
          <li>She listens and explains how she can help</li>
          <li>You leave with a clear next step, no obligation</li>
        </ul>
        <a class="btn btn-line" href="https://calendly.com/katridout/15-minute-investigative-callback">Book a free call</a>
      </article>
      <article class="cmp-card featured rv d2">
        <h3>One-Question Consult</h3>
        <p class="cmp-price">30 minutes <small>by video, new clients</small></p>
        <ul>
          <li>One question answered properly</li>
          <li>One-page written plan within two business days</li>
          <li>New clients only; fee credited if you continue within 30 days</li>
        </ul>
        <a class="btn btn-coral" href="/one-question-consult/">See how it works</a>
      </article>
      <article class="cmp-card rv d3">
        <h3>Initial consultation</h3>
        <p class="cmp-price">75 minutes <small>Milton or telehealth</small></p>
        <ul>
          <li>Complete assessment of where you are</li>
          <li>A plan built around your life, with follow-up</li>
          <li>Medicare rebates may apply with a GPCCMP referral</li>
        </ul>
        <a class="btn btn-line" href="/consultations/">Compare consultations</a>
      </article>
    </div>
  </div>
</section>

<section class="services" id="services">
  <div class="wrap">
    <p class="eyebrow rv">What I help with</p>
    <h2 class="rv d1">Providing evidence-led guidance</h2>
    <p class="intro rv d2">Advice grounded in the latest research and clinical expertise. From everyday nutrition to specialised care in fertility, pregnancy and postpartum, you get practical strategies that fit your life.</p>
    <div class="tiles">
      <article class="tile rv"><h3>Preconception &amp; IVF</h3><p>Three to six months ahead for you and your partner, plus support through every IVF cycle.</p><a href="/our-services/prenatal-nutrition-and-dietetics/">Preconception and IVF nutrition</a></article>
      <article class="tile rv d1"><h3>Pregnancy</h3><p>Trimester by trimester: nausea, aversions, supplements and gestational diabetes handled calmly.</p><a href="/our-services/pregnancy-nutrition-and-dietetics/">Pregnancy nutrition</a></article>
      <article class="tile rv d2"><h3>Post pregnancy</h3><p>Recovery, breastfeeding, energy when sleep is short, and starting solids when bub is ready.</p><a href="/our-services/postnatal-nutrition/">Postnatal nutrition</a></article>
      <article class="tile rv d3"><h3>General nutrition</h3><p>Not planning or pregnant? Kat also sees general nutrition clients, in Milton or by telehealth, with the same evidence-led approach.</p><a href="/our-services/dietitian/">General nutrition</a></article>
    </div>
    <aside class="qq rv d3" id="oneq">
      <div class="qq-text">
        <h3>Just have one question?</h3>
        <p>The One-Question Consult: a 30-minute telehealth call for new clients who need one thing answered properly, with a one-page written plan within two business days. Not a full assessment or meal plan; if you need that, the fee is credited towards an Initial Consultation or The Program within 30 days.</p>
      </div>
      <a class="btn btn-coral" href="/one-question-consult/">Book a One-Question Consult</a>
    </aside>
  </div>
</section>

<section class="about" id="about">
  <div class="wrap">
    <div class="about-photo rv"><img src="/images/kat-ridout-bw.jpg" alt="Katrina Ridout" width="520" height="550" loading="lazy" decoding="async"></div>
    <div>
      <p class="eyebrow rv">About Kat</p>
      <h2 class="rv d1">Qualified, recognised, and <span class="hl">genuinely in your corner</span></h2>
      <p class="rv d2">Katrina is an Accredited Practising Dietitian and an Early Life Nutrition Alliance alumna. She holds a Bachelor of Health Science in Nutrition and Dietetics and a Graduate Certificate in Research in prenatal nutrition from QUT.</p>
      <p class="rv d2">Kat is warm, direct and practical. She keeps her caseload small and sees clients in Milton, Brisbane or by telehealth anywhere in Australia.</p>
      <div class="badges rv d3"><span>Dietitians Australia</span><span>Early Life Nutrition Alliance</span><span>QUT, Nutrition &amp; Dietetics</span></div>
      <div class="stats rv d3">
        <div><div class="big">49</div><small>Google reviews</small></div>
        <div><div class="big">4.9</div><small>average rating</small></div>
        
      </div>
    </div>
  </div>
</section>

<section class="quals" id="qualifications">
  <div class="wrap">
    <p class="eyebrow rv">Qualifications</p>
    <h2 class="rv d1">Credentials you can check</h2>
    <div class="qgrid">
      <div class="qcert rv d1">
        <div class="qnum"><img class="apd" src="/images/apd-logo.webp" alt="Accredited Practising Dietitian" width="127" height="126" loading="lazy"><div><b>APD008207</b><span>Accredited Practising Dietitian · Dietitians Australia</span></div></div>
        <p>Every APD is listed on the national register. <a href="https://member.dietitiansaustralia.org.au/FAAPD_Profile?ID=38519" rel="noopener">Check Katrina's listing on the Dietitians Australia register</a>.</p>
      </div>
      <div class="qlist rv d2">
        <ul>
          <li><b>Accredited Practising Dietitian</b><span>Dietitians Australia</span></li>
          <li><b>Bachelor of Health Science (Nutrition and Dietetics)</b><span>QUT</span></li>
          <li><b>Graduate Certificate in Research, prenatal nutrition</b><span>QUT</span></li>
          <li><b>Early Life Nutrition Alliance, certified</b><span>Fertility, pregnancy and postpartum training</span></li>
          <li><b>Medicare rebates may apply</b><span>With a GP Chronic Condition Management Plan</span></li>
        </ul>
        <img class="eln" src="/images/early-life-nutrition.jpg" alt="Early Life Nutrition Alliance, certified" loading="lazy">
      </div>
    </div>
  </div>
</section>

<section class="journey" id="journey">
  <div class="wrap">
    <p class="eyebrow rv">Your journey with Kat</p>
    <h2 class="rv d1">The process</h2>
    <div class="steps">
      <div class="step rv"><div class="num">Step 1</div><h3>A free 15-minute call</h3><p>Tell Kat where you are at. She will listen, explain honestly how she can help and what that looks like, and suggest the best next step for you.</p></div>
      <div class="step rv d1"><div class="num">Step 2</div><h3>Your initial consult</h3><p>75 minutes in Milton or on video. History, tests, eating and goals, then a plan that fits your life.</p></div>
      <div class="step rv d2"><div class="num">Step 3</div><h3>Your plan and follow-up</h3><p>A written plan you can keep and share, and reviews that keep it current as your body and life change.</p></div>
    </div>
  </div>
</section>

<section class="reviews">
  <div class="wrap">
    <p class="eyebrow rv">Rated 4.9 on Google</p>
    <h2 class="rv d1">Reviews on Google</h2>
    <div class="rating rv d2"><span class="big">4.9</span><span class="stars">★★★★★</span><span>49 Google reviews</span></div>
    <p class="rv d2">Reviews are published on Google by Kat's clients. Read them in full there.</p>
    <a class="btn btn-white rv d3" href="https://g.page/r/CaPM342_gamiEBM/review">Read the reviews on Google</a>
  </div>
</section>

<section class="recipes">
  <div class="wrap">
    <p class="eyebrow rv">Recipes</p>
    <h2 class="rv d1">Easy to make, built for you and your growing baby</h2>
    <p class="lead rv d2">Breakfast, lunch, dinner and snacks, with the nutrients that matter in pregnancy worked in.</p>
    <div class="rgrid">
      <a class="rcard rv" href="/recipes-for-pregnancy/green-smoothie/"><img src="/images/recipe-smoothie.jpg" alt="" loading="lazy" width="400" height="300"><span>Green smoothie</span></a>
      <a class="rcard rv d1" href="/recipes-for-pregnancy/roasted-carrot-and-grain-salad-with-chilli-mint-and-quick-tahini-dressing/"><img src="/images/recipe-carrot.jpg" alt="" loading="lazy" width="400" height="300"><span>Roasted carrot &amp; grain salad</span></a>
      <a class="rcard rv d2" href="/recipes-for-pregnancy/capsicum-tomato-spinach-and-mushroom-omelette/"><img src="/images/recipe-omelette.jpg" alt="" loading="lazy" width="400" height="300"><span>Capsicum, spinach &amp; mushroom omelette</span></a>
      <a class="rcard rv d3" href="/recipes-for-pregnancy/perfect-grilled-salmon-with-green-beans-carrots-and-broccoli/"><img src="/images/recipe-salmon.jpg" alt="" loading="lazy" width="400" height="300"><span>Grilled salmon with greens</span></a>
    </div>
  </div>
</section>

<section class="checklist" id="checklist">
  <div class="wrap">
    <div class="cbox rv">
      <div class="cpic" role="img" aria-label="Preparing vegetables in a kitchen"></div>
      <div class="cform">
        <h2>The free Preconception Checklist</h2>
        <p>One page: the tests to ask your GP about, the supplements that matter, and the first three food changes to make. Sent to your inbox.</p>
        <form id="clForm" novalidate>
          <label for="clName">First name</label>
          <input id="clName" name="fname" type="text" autocomplete="given-name" required>
          <label for="clEmail">Email</label>
          <input id="clEmail" name="email" type="email" autocomplete="email" required>
          <button class="btn btn-coral" type="submit">Email me the checklist</button>
          <small>You'll also get a short series of emails from Kat. Unsubscribe any time. <a href="/privacy-policy/">Privacy policy</a></small>
          <p class="ok" id="clOk" role="status" aria-live="polite">Sent. Check your inbox in a minute.</p>
          <p class="err" id="clErr" role="alert">That didn't send. Please email <a href="mailto:info@katridout.com.au">info@katridout.com.au</a> and we'll send the checklist by hand.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<section class="contact" id="contact">
  <div class="wrap">
    <div class="ebox rv">
      <div>
        <h2>Have a question before you book?</h2>
        <p>Send a note and Kat will reply by email. For bookings, the free 15-minute call is the quickest way to start.</p>
        <p class="edetails"><a href="tel:1300640104">1300 640 104</a><br><a href="mailto:info@katridout.com.au">info@katridout.com.au</a><br>Milton Village Medical, Level 1, 36 Baroona Road, Milton QLD 4064</p>
      </div>
      <form id="eqForm" novalidate>
        <label for="eqName">Name</label>
        <input id="eqName" name="name" type="text" autocomplete="name" required>
        <label for="eqEmail">Email</label>
        <input id="eqEmail" name="email" type="email" autocomplete="email" required>
        <label for="eqMsg">Your question</label>
        <textarea id="eqMsg" name="message" rows="4" required></textarea>
        <button class="btn btn-dark" type="submit">Send enquiry</button>
        <small>Sent to Kat by email. <a href="/privacy-policy/">Privacy policy</a></small>
        <p class="ok" id="eqOk" role="status" aria-live="polite">Sent. Kat will reply by email.</p>
        <p class="err" id="eqErr" role="alert">That didn't send. Please email <a href="mailto:info@katridout.com.au">info@katridout.com.au</a> or call <a href="tel:1300640104">1300 640 104</a>.</p>
      </form>
    </div>
  </div>
</section>

<section class="articles">
  <div class="wrap">
    <p class="eyebrow rv">From Kat</p>
    <h2 class="rv d1">Answers to the questions you're searching</h2>
    <div class="agrid">
      <a class="acard rv" href="/blogs/foods-to-avoid-during-pregnancy-australia/"><span class="cat">Pregnancy</span><h3>What foods should you avoid during pregnancy in Australia?</h3><p>The current Australian guidance, without the fear.</p><span class="more">Read →</span></a>
      <a class="acard rv d1" href="/blogs/gestational-diabetes-meal-plan-guide/"><span class="cat">Gestational diabetes</span><h3>What should a gestational diabetes meal plan look like?</h3><p>A day of eating that keeps glucose steady and still tastes like food.</p><span class="more">Read →</span></a>
      <a class="acard rv d2" href="/blogs/what-should-i-eat-while-breastfeeding/"><span class="cat">Postpartum</span><h3>What should I eat while breastfeeding?</h3><p>Energy, supply and recovery, with real meals for tired days.</p><span class="more">Read →</span></a>
    </div>
    <a class="btn btn-dark rv d3" style="margin-top:2rem" href="/blogs/">All articles</a>
  </div>
</section>

<section class="faq" id="faq">
  <div class="wrap">
    <p class="eyebrow rv" style="color:var(--coral-deep)">Good to know</p>
    <h2 class="rv d1" style="margin:.6rem 0 1.6rem">Questions people ask first</h2>
    <details class="rv"><summary>Do I need a referral?</summary><p>No. Anyone can book directly. For a Medicare rebate, ask your GP for a Chronic Condition Management Plan first and bring the referral.</p></details>
    <details class="rv"><summary>Can we do this by telehealth?</summary><p>Yes. Consults run on video with the same written plan and follow-up.</p></details>
    <details class="rv"><summary>Should my partner come too?</summary><p>For preconception and IVF, yes if they can. Sperm health responds to nutrition as well, and plans work better when you are both on them.</p></details>
    <details class="rv"><summary>What do I get after a consult?</summary><p>A written plan you can keep and share with your GP or specialist, plus the option of review appointments as things change.</p></details>
  </div>
</section>
<BookBar slot="after" />
<script is:inline slot="after">
(function(){
  document.documentElement.classList.add('js');
  var bar=document.getElementById('bookbar');
  function onScroll(){ bar.classList.toggle('show',window.scrollY>480); }
  window.addEventListener('scroll',onScroll,{passive:true}); onScroll();
  var io=new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target);} }); },{rootMargin:'0px 0px -8% 0px',threshold:.1});
  document.querySelectorAll('.rv').forEach(function(el){ io.observe(el); });
  var ENDPOINT='https://hook.eu1.make.com/7ws9ylhmcf8pwpnmeh4k6bq58bu6i6oe';
  function wire(id,okId,errId,formName,redirect){var f=document.getElementById(id);if(!f)return;f.addEventListener('submit',function(ev){ev.preventDefault();var ok=true;[].forEach.call(f.querySelectorAll('[required]'),function(el){if(!el.checkValidity()){ok=false;el.reportValidity();}});if(!ok)return;var btn=f.querySelector('button');var okEl=document.getElementById(okId),errEl=document.getElementById(errId);okEl.classList.remove('show');errEl.classList.remove('show');btn.disabled=true;var label=btn.textContent;btn.textContent='Sending…';var data={form:formName,page:location.href};[].forEach.call(f.querySelectorAll('input,textarea'),function(el){data[el.name]=el.value.trim();});fetch(ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}).then(function(r){if(!r.ok)throw new Error(r.status);window.dataLayer=window.dataLayer||[];window.dataLayer.push({event:'form_submit_success',form:formName});window.dataLayer.push({event:'form_submit_'+formName});if(redirect){location.href=redirect;return;}okEl.classList.add('show');f.reset();btn.textContent=label;}).catch(function(){errEl.classList.add('show');btn.disabled=false;btn.textContent=label;});});}
  wire('clForm','clOk','clErr','checklist');wire('eqForm','eqOk','eqErr','enquiry','/thank-you/?enquiry=sent');
