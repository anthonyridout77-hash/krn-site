---
import { getCollection } from 'astro:content';
import Listing from '../../../layouts/Listing.astro';
import BlogGrid from '../../../components/BlogGrid.astro';
import { slugify, categoryLabel } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const names = new Map<string, string>();
  for (const p of posts) for (const c of p.data.categories ?? []) names.set(slugify(c), c);
  return [...names.entries()].map(([slug, name]) => ({
    params: { slug },
    props: { name, posts: posts.filter((p) => (p.data.categories ?? []).some((c) => slugify(c) === slug)), all: posts },
  }));
}
const { name, posts, all } = Astro.props;
const label = categoryLabel(name);
---
<Listing
  title={`${label} articles`}
  heading={label}
  description={`Articles on ${label === name ? name.toLowerCase() : label} from Katrina Ridout, Accredited Practising Dietitian. Fertility, pregnancy and postpartum nutrition, Brisbane and telehealth Australia-wide.`}
  lede="General information only; it is not a substitute for individual advice."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Articles', href: '/blogs/' }, { label }]}
>
  <BlogGrid posts={posts} all={all} active={name} />
</Listing>
