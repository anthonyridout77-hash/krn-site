---
/* Focused consultation page. The ONLY page that shows the fee.
   Copy comes from src/data/focused-consult.ts. DRAFT pending Kat (public health copy gate). */
import Base from '../layouts/Base.astro';
import BookBar from '../components/BookBar.astro';
import { fc } from '../data/focused-consult';
import '../styles/one-question.css';
const CALL = 'https://calendly.com/katridout/15-minute-investigative-callback';
---
<Base title={`${fc.name} | Katrina Ridout Nutrition`} description="A focused 30-minute telehealth appointment with Accredited Practising Dietitian Katrina Ridout for one suitable nutrition concern, with a brief written summary. New clients only." noindex={true}>
<section class="hero">
  <div class="wrap">
    <div>
      <p class="kicker">Paid consultation · {fc.duration} · telehealth</p>
      <h1>{fc.heading}</h1>
      <p class="lede">The {fc.name} is a focused appointment for one suitable nutrition concern. It includes relevant background questions, practical advice within the agreed scope, and a brief written summary of the discussion and next steps.</p>
      <div class="price"><b>{fc.fee}</b><small>total fee · GST-free · paid when you book · {fc.duration} by telehealth · written summary within {fc.turnaround}</small></div>
      <div class="cta-row">
        <a class="btn btn-coral" href="#book">Book a consult</a>
        <a class="btn btn-line" href="#fit">Is it right for me?</a>
      </div>
      <div class="trust"><span><img class="apd" src="/images/apd-logo.webp" alt="Accredited Practising Dietitian" width="127" height="126" loading="lazy"> Dietitians Australia</span><span>{fc.eligibility}</span></div>
    </div>
    <div class="hero-photo">
      <img src="/images/kat-ridout-apd.jpg" alt="Katrina Ridout, Accredited Practising Dietitian" width="480" height="480" fetchpriority="high">
      <div class="tag"><b>Katrina Ridout</b>Accredited Practising Dietitian</div>
    </div>
  </div>
</section>

<section id="how">
  <div class="wrap">
    <h2>How it works</h2>
    <div class="cols">
      <div class="card"><div class="n">1</div><h3>Tell Kat your concern</h3><p>When you book, briefly describe the concern and where you are up to. Kat reviews it within 1 business day to check it suits a focused consult.</p></div>
      <div class="card"><div class="n">2</div><h3>{fc.duration} with Kat by telehealth</h3><p>Kat asks the background questions she needs, clarifies what matters, and gives practical advice within the agreed scope.</p></div>
      <div class="card"><div class="n">3</div><h3>Your brief written summary</h3><p>Within {fc.turnaround} you receive a short written record of the advice discussed and the next steps you agreed.</p></div>
    </div>
  </div>
</section>

<section class="band" id="fit">
  <div class="wrap">
    <h2>Is a focused consult right for you?</h2>
    <div class="two">
      <div class="list"><h3>It includes</h3><ul>
        {fc.includes.map((i) => <li>{i}</li>)}
      </ul></div>
      <div class="list no"><h3>An initial consultation is usually more appropriate when</h3><ul>
        {fc.initialBetterWhen.map((i) => <li>{i}</li>)}
      </ul></div>
    </div>
    <p class="fine">A single question can still need a full assessment. For example, "What should I eat during IVF?" usually depends on your history, results and treatment plan. {fc.initialPitch} Not sure which suits you? <a href={CALL}>Book a free call</a> and Kat will help you choose.</p>
  </div>
</section>

<section id="summary">
  <div class="wrap">
    <h2>About the written summary</h2>
    <p>{fc.deliverableDetail} It is sent by email within {fc.turnaround} of your appointment.</p>
  </div>
</section>

<section id="about">
  <div class="wrap">
    <div class="about">
      <img src="/images/kat-ridout-apd.jpg" alt="" width="480" height="480" loading="lazy" decoding="async">
      <div>
        <h2>With Kat herself</h2>
        <p>Katrina Ridout is an Accredited Practising Dietitian and Nutritionist, an Early Life Nutrition Alliance alumna, and holds a Graduate Certificate in Research in prenatal nutrition. She works in preconception, IVF, pregnancy and postpartum nutrition from Milton, Brisbane, and by telehealth across Australia.</p>
      </div>
    </div>
  </div>
</section>

<section id="faq">
  <div class="wrap">
    <h2>Questions</h2>
    <div style="margin-top:1.4rem">
      <details><summary>What does the {fc.fee} cover?</summary><p>{fc.duration} with Kat by telehealth for one agreed concern, including the background questions she needs, practical advice within that scope, and a brief written summary within {fc.turnaround}. It is the total fee; dietetic services are GST-free.</p></details>
      <details><summary>Is it limited to one question?</summary><p>No. It is limited to one focused concern, not one sentence. Kat will ask follow-up questions and you can ask for clarification during the appointment. If several concerns need looking at together, an initial consultation is usually the better fit.</p></details>
      <details><summary>What if my concern needs a broader assessment?</summary><p>{fc.suitability} If something more complex comes up during the appointment, Kat will decide how to proceed safely and explain your options.</p></details>
      <details><summary>Can I claim this on Medicare or private health?</summary><p>It is private-pay only, so no GP referral is needed and it does not use one of your GP Chronic Condition Management Plan visits. Medicare rebates apply to standard consultations.</p></details>
      <details><summary>If I book more care later, is the fee credited?</summary><p>{fc.credit}</p></details>
      <details><summary>What if I need to cancel?</summary><p>Reschedule or cancel free of charge up to 24 hours before your appointment for a full refund. Inside 24 hours the fee is retained.</p></details>
      <details><summary>How is it different from the free 15-minute call?</summary><p>On the free call Kat listens to what is going on, explains how she can help and suggests the best next step. The {fc.name} is a paid appointment where she gives you advice on your agreed concern, with a written summary.</p></details>
    </div>
  </div>
</section>

<section id="book">
  <div class="wrap">
    <div class="book">
      <div>
        <h2>Book your {fc.name}</h2>
        <p><b>{fc.fee} total</b>, paid when you book. {fc.duration} by telehealth, one agreed concern, brief written summary within {fc.turnaround}. {fc.eligibility}. Free cancellation up to 24 hours before.</p>
        <p class="fine">{fc.suitability}</p>
      </div>
      <a class="btn btn-ink" href={fc.booking}>Choose a time</a>
    </div>
  </div>
</section>
<BookBar slot="after" label={`${fc.name}<br>${fc.fee} · 30 min · telehealth`} cta="Book now" href="#book" />
<script is:inline slot="after">
(function(){var b=document.getElementById('bookbar');function t(){b.classList.toggle('show',window.scrollY>420)}window.addEventListener('scroll',t,{passive:true});t();})();
</script>
</Base>
