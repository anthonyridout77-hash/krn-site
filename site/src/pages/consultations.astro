---
/* Consultations: a decision guide. Replaces /fees-and-rebates/ (redirected).
   Decision 6 Nov 2026: NO consult or program prices on the website. Fees are shown on the booking page
   (One-Question) or confirmed when booking / on the free call. The only dollar figure here is the Medicare
   rebate (government number, per Services Australia as at 1 Jul 2026; keep current).
   Structure per 6 Nov review: starter cards -> existing clients -> ongoing support -> pathways (supplementary)
   -> compact comparison -> rebates and policies. Public health copy lives in src/data/pathways.ts (Kat gate). */
import Article from '../layouts/Article.astro';
import PathwayTimelines from '../components/PathwayTimelines.astro';
import { pathways } from '../data/pathways';
import { fc } from '../data/focused-consult';
const rebate = '$63.40';
const CALL = 'https://calendly.com/katridout/15-minute-investigative-callback';

const starters = [
  { id: 'initial', q: 'Want to look at the whole picture?', name: 'Initial consultation', best: 'Anyone wanting a comprehensive assessment and a coordinated plan', time: '75 minutes, Milton or telehealth', what: 'A full assessment of your history, bloods, medications and eating that connects several concerns and priorities into one coordinated plan. Ongoing support is optional; Kat helps you decide whether individual appointments or a program suits you.', get: 'Assessment summary, individualised supplement plan, starter meal plan, recipe booklet, snack ideas and goals summary, within 2 business days.', paid: true, cta: 'Discuss my options with Kat', href: CALL, coral: true, note: 'Books the free introductory call first.' },
  { id: 'call', q: 'Not sure which option suits you?', name: 'Free introductory call', best: 'Anyone who would like to talk it through first', time: '15 minutes, phone', what: 'Tell Kat what is going on. She will listen, explain how she would approach it and how she can help. Personalised meal plans and supplement advice are kept for a consultation.', get: 'A clear, caring next step that suits you, with no obligation.', paid: false, cta: 'Book a free call', href: CALL, coral: false },
  { id: 'oneq', q: fc.heading, name: fc.name, best: 'New clients with one suitable, focused nutrition concern', time: '30 minutes, video', what: fc.summary, get: `A brief written summary of the advice and agreed next steps, within ${fc.turnaround}.`, paid: true, cta: 'View details and fee', href: fc.url, coral: false },
];

const cols = ['Initial consultation', 'Free call', 'One-Question Consult'];
const rows: { label: string; cells: string[] }[] = [
  { label: 'Who it suits', cells: ['Anyone wanting the whole picture', 'Anyone deciding', 'New clients with one suitable, focused concern'] },
  { label: 'Duration and format', cells: ['75 min, Milton or telehealth', '15 min, phone', '30 min, video'] },
  { label: 'Assessment', cells: ['Comprehensive', 'A conversation about your situation', 'Relevant to the agreed concern'] },
  { label: 'Written takeaway', cells: ['Full plan and resources, 2 business days', 'None', 'Brief written summary, 2 business days'] },
  { label: 'Follow-up', cells: ['Review appointments or a program, only if you want them', 'Kat suggests the option that suits you', 'Further care only if you need broader support'] },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    ...pathways.map((p) => ({
      '@type': 'HowTo',
      name: `${p.name}: an example appointment schedule`,
      description: p.story,
      step: p.consults.map((c, i) => ({ '@type': 'HowToStep', position: i + 1, name: `${c.when}: ${c.title}`, text: c.detail })),
    })),
    {
      '@type': 'FAQPage',
      mainEntity: [
        { '@type': 'Question', name: 'Do I have to commit to a program?', acceptedAnswer: { '@type': 'Answer', text: 'No. You can book a single initial consultation. If you book The Program within 14 days of your initial consultation, that consultation counts as its first appointment.' } },
        { '@type': 'Question', name: 'How many appointments are in a program?', acceptedAnswer: { '@type': 'Answer', text: 'The Program is five appointments: one 75-minute initial consultation and four reviews, usually across about 12 weeks. The Journey is eight: one initial consultation and seven reviews spaced across a pregnancy and into the first weeks after birth. Timing is flexible to you.' } },
        { '@type': 'Question', name: 'Does Medicare cover dietitian consultations?', acceptedAnswer: { '@type': 'Answer', text: 'If your GP refers you under a GP Chronic Condition Management Plan you may receive a Medicare rebate of $63.40 per consultation for up to five allied-health visits a calendar year. Eligibility is your GP\'s decision. Private health extras may also apply; you cannot claim both for the same consultation.' } },
      ],
    },
  ],
};
---
<Article
  title="Consultations"
  description="Choose the support that fits you: a full initial consultation, a free introductory call or a focused One-Question Consult with Katrina Ridout, Accredited Practising Dietitian. How programs work and how Medicare rebates apply."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Consultations' }]}
  lede="Choose your starting point. An initial consultation looks at the whole picture; a free introductory call helps if you are unsure; a focused paid consult suits one well-defined concern."
  ctaHeading="Still unsure?"
  ctaText="Book a free 15-minute call. Tell Kat what is going on, she will listen, explain how she can help, and suggest the best next step for you."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <nav class="jump" aria-label="On this page">
    <a href="#start">Where to start</a>
    <a href="#ongoing">How ongoing support works</a>
    <a href="#pathways">Your situation</a>
    <a href="#compare">Compare</a>
    <a href="#medicare">Medicare and payment</a>
  </nav>

  <h2 id="start">Choose your starting point</h2>
  <div class="starters">
    {starters.map((s) => (
      <article class={`starter starter-${s.id}`}>
        <p class="q">{s.q}</p>
        <h3>{s.name} {s.paid ? <span class="tag">Paid consultation</span> : <span class="tag tag-free">Free</span>}</h3>
        <dl>
          <div><dt>Who it suits</dt><dd>{s.best}</dd></div>
          <div><dt>Duration and format</dt><dd>{s.time}</dd></div>
          <div><dt>What happens</dt><dd>{s.what}</dd></div>
          <div><dt>What you receive</dt><dd>{s.get}</dd></div>
        </dl>
        <a class={`btn ${s.coral ? 'btn-coral' : 'btn-line'}`} href={s.href}>{s.cta}</a>
        {'note' in s && <p class="card-note">{(s as any).note}</p>}
      </article>
    ))}
  </div>
  <p class="reassure"><b>Kat will explain the fees and inclusions before you decide to proceed.</b> The One-Question Consult fee is shown on its page before you pay. For initial consultations and programs, fees and options are discussed on your free call. The free call does not commit you to anything, and there is no obligation to book ongoing care.</p>

  <aside class="existing">
    <p><b>Already a client?</b> <a href="/contact-us/">Contact Kat to arrange a review</a> (30 minutes, or 45 for a change of stage).</p>
  </aside>

  <h2 id="ongoing">How ongoing support works</h2>
  <ol class="flow">
    <li><b>Assessment.</b> Your initial consultation: history, bloods, medications, eating and goals.</li>
    <li><b>Practical plan.</b> Supplement plan, starter meal plan and resources, within 2 business days.</li>
    <li><b>Reviews and adjustments.</b> Shorter appointments to check what is working and update the plan as results and your stage change.</li>
  </ol>
  <p>You can book appointments one at a time, or as a program. Programs include the initial consultation, so they are not a separate starting appointment. See <a href="#changing">changing from one option to another</a> for how a single appointment can count towards a program.</p>
  <div class="programs">
    <article class="program">
      <h3>The Program</h3>
      <p><b>5 appointments in total:</b> the 75-minute initial consultation plus four reviews (30, 45, 30 and 30 minutes), usually across about 12 weeks and flexible to your stage.</p>
      <p><b>Included:</b> everything from the initial consultation, a 45-minute pathology review with your meal plan and supplement plan updated, a partner handout, and messaging support between appointments. Use within 12 months.</p>
      <p class="fine"><b>Messaging support:</b> short questions between appointments, answered on weekdays, usually within 48 hours. It is not for urgent medical concerns; contact your GP, midwife or 000.</p>
    </article>
    <article class="program">
      <h3>The Journey</h3>
      <p><b>8 appointments in total:</b> the initial consultation plus seven reviews spaced across a pregnancy and into the first weeks after birth.</p>
      <p><b>Included:</b> everything in The Program, plus a third-trimester plan update, a birth and early breastfeeding guide, and a postpartum appointment within six weeks of birth. Use within 12 months.</p>
    </article>
  </div>
  <p class="fine">Appointments outside a program (for example an extra review, or a partner appointment) are booked and charged separately. Program appointments can be used across stages, for example moving from preconception into pregnancy.</p>

  <h2 id="pathways">What it looks like for your situation</h2>
  <p>Pick your situation for a short summary. Open the example schedule if you would like to see how appointments are usually spaced. Timing in the examples is counted from your first appointment unless it says otherwise (for example weeks of pregnancy).</p>
  <PathwayTimelines />

  <h2 id="compare">Compare at a glance</h2>
  <p class="scroll-hint">On a phone, scroll sideways to compare all three options.</p>
  <div class="table-wrap" role="region" aria-label="Comparison of starting options" tabindex="0">
    <table class="matrix">
      <caption class="sr">Comparison of the three starting options: initial consultation, free call and One-Question Consult</caption>
      <thead>
        <tr>
          <th scope="col" class="rowhead"><span class="sr">Feature</span></th>
          {cols.map((c) => <th scope="col">{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row" class="rowhead">{r.label}</th>
            {r.cells.map((c) => <td>{c}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="changing">Changing from one option to another</h2>
  <ul>
    <li><b>From a One-Question Consult:</b> {fc.credit}</li>
    <li><b>From a single initial consultation:</b> if you book The Program within 14 days of your initial consultation, that consultation counts as the program's first appointment.</li>
    <li><b>Extra appointments:</b> anything outside a program, such as an additional review or a partner appointment, is booked and charged separately.</li>
  </ul>

  <h2 id="medicare">Medicare rebates</h2>
  <ul>
    <li>Your GP may refer you under a GP Chronic Condition Management Plan (GPCCMP) if they consider dietetic care appropriate. Eligibility is your GP's decision.</li>
    <li>The plan allows up to five allied-health visits per calendar year, shared across every allied-health professional on your plan (for example a physiotherapist or psychologist as well as a dietitian). How many of your program appointments attract a rebate depends on how many of those visits you have left.</li>
    <li>The Medicare rebate for a dietitian consultation is {rebate} per visit as at 1 July 2026. You pay the fee on the day and the rebate is claimed back for you.</li>
    <li>The One-Question Consult is private-pay only and does not use one of your five visits.</li>
  </ul>

  <h2>Private health</h2>
  <p>Many extras policies include dietetics. Check with your fund for your cover level. You cannot claim both Medicare and private health on the same consultation.</p>

  <h2 id="payment">Payment, cancellations and refunds</h2>
  <ul>
    <li>Dietetic services are GST-free.</li>
    <li>Consultations are paid on the day. The One-Question Consult is prepaid when you book. Programs can be paid in full or in instalments.</li>
    <li>Reschedule or cancel free of charge up to 24 hours before your appointment. Inside 24 hours the fee is retained.</li>
    <li>Program appointments can be used within 12 months of purchase.</li>
  </ul>
</Article>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .jump { display: flex; flex-wrap: wrap; gap: .4rem .5rem; margin: 0 0 1rem; }
  .jump a { font-size: .88rem; text-decoration: none; border: 1px solid var(--line); border-radius: 999px; padding: .35rem .75rem; color: var(--heading); }
  .jump a:hover { background: var(--mint); }

  /* Break out of the 68ch article column */
  .starters, .programs, .table-wrap { width: min(1100px, calc(100vw - 40px)); position: relative; left: 50%; transform: translateX(-50%); }
  @media (max-width: 759px) { .starters, .programs, .table-wrap { width: auto; left: auto; transform: none; } }

  .starters { display: grid; gap: 1rem; margin: .6rem 0 1.2rem; align-items: start; }
  @media (min-width: 760px) { .starters { align-items: stretch; } }
  @media (min-width: 760px) { .starters { grid-template-columns: repeat(3, 1fr); } }
  .starter { background: var(--mint); border-radius: 22px; padding: 1.4rem 1.3rem; display: flex; flex-direction: column; gap: .8rem; }
  .starter .q { margin: 0; font-weight: 600; color: var(--heading); font-size: 1.05rem; }
  .tag { display: inline-block; vertical-align: middle; margin-left: .3rem; font-size: .7rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; border: 1px solid var(--heading); color: var(--heading); border-radius: 999px; padding: .1rem .5rem; }
  .card-note { margin: -.3rem 0 0; font-size: .8rem; color: var(--fg-soft); }
  .reassure { margin: 0 0 1.4rem; font-size: .95rem; }
  .flow { margin: .8rem 0 1rem; padding-left: 1.2rem; display: grid; gap: .4rem; }
  .starter h3 { margin: 0; font-size: 1rem; color: var(--fg); }
  .starter dl { margin: 0; display: grid; gap: .55rem; flex: 1; }
  .starter dt { font-size: .78rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--fg-soft); }
  .starter dd { margin: .1rem 0 0; font-size: .95rem; }
  .starter .btn { align-self: start; }
  .starter .btn-coral, .starter .btn-coral:hover { color: #fff; }

  .existing { margin: 0 0 2rem; padding: .9rem 1.1rem; border: 1px solid var(--line); border-radius: 14px; font-size: .95rem; }
  .existing p { margin: 0; }

  .programs { display: grid; gap: 1rem; margin: 1rem 0 1rem; }
  @media (min-width: 760px) { .programs { grid-template-columns: 1fr 1fr; } }
  .program { border: 1.5px solid var(--line); border-radius: 22px; padding: 1.4rem 1.3rem; }
  .program h3 { margin: 0 0 .5rem; }
  .program p + p { margin-top: .6rem; }
  .fine { font-size: .92rem; color: var(--fg-soft); }

  .table-wrap { overflow-x: auto; margin: .4rem 0 2rem; }
  .table-wrap:focus-visible { outline: 3px solid var(--heading); outline-offset: 3px; border-radius: 6px; }
  .scroll-hint { font-size: .85rem; color: var(--fg-soft); margin: .8rem 0 0; }
  @media (min-width: 760px) { .scroll-hint { display: none; } }
  .matrix { width: 100%; min-width: 560px; border-collapse: collapse; font-size: .92rem; }
  .matrix th, .matrix td { padding: .7rem .7rem; border-bottom: 1px solid var(--line); vertical-align: top; text-align: left; }
  .matrix thead th { border-bottom: 2px solid var(--line); color: var(--heading); }
  .matrix .rowhead { font-weight: 600; color: var(--fg); width: 18%; position: sticky; left: 0; background: var(--bg); box-shadow: 1px 0 0 var(--line); z-index: 1; }
</style>
