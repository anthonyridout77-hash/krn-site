---
/* Consultations: a decision guide. Replaces /fees-and-rebates/ (redirected).
   Decision 6 Nov 2026: NO consult or program prices on the website. Fees are explained on the free call
   before anyone books. One-Question Consult retired 7 Nov 2026 (public pathway: free call -> initial -> reviews or program). The only dollar figure here is the Medicare
   rebate (government number, per Services Australia as at 1 Jul 2026; keep current).
   Structure per 6 Nov review: starter cards -> existing clients -> ongoing support -> pathways (supplementary)
   -> compact comparison -> rebates and policies. Public health copy lives in src/data/pathways.ts (Kat gate). */
import Article from '../layouts/Article.astro';
import PathwayTimelines from '../components/PathwayTimelines.astro';
import { pathways } from '../data/pathways';
const CALL = 'https://calendly.com/katridout/15-minute-investigative-callback';

const steps = [
  { id: 'call', n: 1, name: 'Free introductory call', tag: 'Free', time: '15 minutes, phone. Kat calls you.', what: 'Bring your initial concerns. Kat listens and asks a few preliminary questions, then explains her approach, the appointment options that suit you, what working together could involve, and the fees and inclusions. You do not need to have it all worked out first. The full assessment happens at your initial consultation.', get: 'A clear next step that suits you, with no obligation.', cta: 'Book a free 15-minute call', href: CALL, coral: true },
  { id: 'initial', n: 2, name: 'Initial consultation', tag: 'Paid consultation', time: '75 minutes, in Milton or by telehealth.', what: 'A comprehensive consultation exploring your history, diet, results, medications, preferences and practical circumstances. Concerns are looked at together rather than one at a time, and Kat develops an individualised nutrition plan with you.', get: 'Your written plan and resources within 2 business days (see below).', cta: 'Start with a free call', href: CALL, coral: false, note: 'Initial consultations are arranged after your free call.' },
];

const receive = [
  'An assessment summary',
  'An individualised supplement plan, where appropriate',
  'A starter meal plan',
  'A recipe booklet and snack ideas',
  'A summary of the goals you agreed',
];

const cols = ['Individual reviews', 'The Program', 'The Journey'];
const rows: { label: string; cells: string[] }[] = [
  { label: 'Appointments', cells: ['Booked one at a time, as you need them', '5 in total, including the initial consultation', '8 in total, including the initial consultation'] },
  { label: 'Usual timeframe', cells: ['Flexible', 'About 12 weeks, flexible to your stage', 'Across a pregnancy and into the first weeks after birth'] },
  { label: 'Payment', cells: ['Paid on the day', 'In full or in instalments', 'In full or in instalments'] },
  { label: 'Use within', cells: ['Not applicable', '12 months', '12 months'] },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    ...pathways.map((p) => ({
      '@type': 'HowTo',
      name: `${p.name}: an example appointment schedule`,
      description: p.story,
      step: p.consults.map((c, i) => ({ '@type': 'HowToStep', position: i + 1, name: `${c.when}: ${c.title}`, text: c.detail })),
    })),
    {
      '@type': 'FAQPage',
      mainEntity: [
        { '@type': 'Question', name: 'Do I have to commit to a program?', acceptedAnswer: { '@type': 'Answer', text: 'No. You can book a single initial consultation. If you book The Program within 14 days of your initial consultation, that consultation counts as its first appointment.' } },
        { '@type': 'Question', name: 'How many appointments are in a program?', acceptedAnswer: { '@type': 'Answer', text: 'The Program is five appointments: one 75-minute initial consultation and four reviews, usually across about 12 weeks. The Journey is eight: one initial consultation and seven reviews spaced across a pregnancy and into the first weeks after birth. Timing is flexible to you.' } },
        { '@type': 'Question', name: 'Does Medicare cover dietitian consultations?', acceptedAnswer: { '@type': 'Answer', text: 'If your GP refers you under a GP Chronic Condition Management Plan you may receive a Medicare rebate for up to five allied-health visits a calendar year. Eligibility is your GP\'s decision. Private health extras may also apply; you cannot claim both for the same consultation.' } },
      ],
    },
  ],
};
---
<Article
  title="Consultations"
  description="How to start with Katrina Ridout, Accredited Practising Dietitian: a free 15-minute call, then a comprehensive initial consultation, then individual reviews or an optional program. How Medicare rebates apply."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Consultations' }]}
  lede="Start with a conversation. Build a plan around you. Most new clients begin with a free 15-minute call, then an initial consultation. Ongoing support is your choice."
  ctaHeading="Ready to start?"
  ctaText="Book a free 15-minute call. Tell Kat what is going on, she will listen, explain how she can help and talk you through the options."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <nav class="jump" aria-label="On this page">
    <a href="#start">Your first steps</a>
    <a href="#receive">What you receive</a>
    <a href="#ongoing">Ongoing support</a>
    <a href="#pathways">Your situation</a>
    <a href="#existing">Existing clients</a>
    <a href="#medicare">Medicare and payment</a>
  </nav>

  <p class="journey" aria-label="How it works"><span>Free call</span><span aria-hidden="true">→</span><span>Initial consultation</span><span aria-hidden="true">→</span><span>Reviews or a program, if you want them</span></p>

  <h2 id="start">Your first steps</h2>
  <div class="starters">
    {steps.map((s) => (
      <article class={`starter starter-${s.id}`}>
        <p class="q">Step {s.n}</p>
        <h3>{s.name} <span class={`tag ${s.tag === 'Free' ? 'tag-free' : ''}`}>{s.tag}</span></h3>
        <dl>
          <div><dt>Time and format</dt><dd>{s.time}</dd></div>
          <div><dt>What happens</dt><dd>{s.what}</dd></div>
          <div><dt>What you leave with</dt><dd>{s.get}</dd></div>
        </dl>
        <a class={`btn ${s.coral ? 'btn-coral' : 'btn-line'}`} href={s.href}>{s.cta}</a>
        {'note' in s && <p class="card-note">{(s as any).note}</p>}
      </article>
    ))}
  </div>
  <p class="reassure"><b>Kat will explain the fees and inclusions before you decide to proceed.</b> The initial consultation and any later appointments are paid. There is no obligation to book ongoing care.</p>

  <h2 id="receive">What you receive from the initial consultation</h2>
  <p>Within 2 business days of your initial consultation you receive:</p>
  <ul>
    {receive.map((r) => <li>{r}</li>)}
  </ul>
  <p class="fine">What is in your plan depends on your assessment. Review appointments and programs are optional and separate.</p>

  <h2 id="ongoing">How ongoing support works</h2>
  <ol class="flow">
    <li><b>Understand.</b> Your initial consultation: history, results, medications, eating and goals.</li>
    <li><b>Agree a practical plan.</b> Written plan and resources within 2 business days.</li>
    <li><b>Review and adapt.</b> Shorter appointments to check what is working and update the plan as results and your stage change.</li>
  </ol>
  <p>After your initial consultation, you and Kat decide together whether you need more support. You can book individual reviews as you need them, or choose a program for more continuity. <b>Programs include the initial consultation</b>, so they are not an extra starting appointment.</p>
  <div class="programs">
    <article class="program">
      <h3>The Program</h3>
      <p><b>5 appointments in total:</b> the 75-minute initial consultation plus four reviews (30, 45, 30 and 30 minutes), usually across about 12 weeks and flexible to your stage.</p>
      <p><b>Included:</b> everything from the initial consultation, a 45-minute pathology review with your meal plan and supplement plan updated, a partner handout, and messaging support between appointments. Use within 12 months.</p>
      <p class="fine"><b>Messaging support:</b> short questions between appointments, answered on weekdays, usually within 48 hours. It is not for urgent medical concerns; contact your GP, midwife or 000.</p>
    </article>
    <article class="program">
      <h3>The Journey</h3>
      <p><b>8 appointments in total:</b> the initial consultation plus seven reviews spaced across a pregnancy and into the first weeks after birth.</p>
      <p><b>Included:</b> everything in The Program, plus a third-trimester plan update, a birth and early breastfeeding guide, and a postpartum appointment within six weeks of birth. Use within 12 months.</p>
      <p class="fine"><b>Joining later in pregnancy?</b> Kat can see you for individual consultations or create a tailored package for the weeks you have left.</p>
    </article>
  </div>

  <h3 class="cmp-h">Individual reviews or a program?</h3>
  <p class="scroll-hint">On a phone, scroll sideways to see all three.</p>
  <div class="table-wrap" role="region" aria-label="Individual reviews compared with programs" tabindex="0">
    <table class="matrix">
      <caption class="sr">Individual reviews compared with The Program and The Journey</caption>
      <thead>
        <tr>
          <th scope="col" class="rowhead"><span class="sr">Feature</span></th>
          {cols.map((c) => <th scope="col">{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row" class="rowhead">{r.label}</th>
            {r.cells.map((c) => <td>{c}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <ul class="fine">
    <li>If you book The Program within 14 days of a single initial consultation, that consultation counts as the program's first appointment.</li>
    <li>Appointments outside a program, such as an extra review or a partner appointment, are booked and charged separately. Program appointments can be used across stages, for example moving from preconception into pregnancy.</li>
  </ul>

  <h2 id="pathways">Explore your situation</h2>
  <p>Pick your situation for a short summary. Every plan is personal: Kat works out what you need at your initial consultation. Open the example schedule to see how appointments are often spaced.</p>
  <PathwayTimelines />

  <h2 id="existing">Already a client?</h2>
  <p><a href="/contact-us/">Contact Kat to arrange a review</a> (30 minutes, or 45 for a change of stage).</p>

  <h2 id="medicare">Medicare rebates</h2>
  <ul>
    <li>Your GP may refer you under a GP Chronic Condition Management Plan (GPCCMP) if they consider dietetic care appropriate. Eligibility is your GP's decision.</li>
    <li>The plan allows up to five allied-health visits per calendar year, shared across every allied-health professional on your plan (for example a physiotherapist or psychologist as well as a dietitian). How many of your program appointments attract a rebate depends on how many of those visits you have left.</li>
    <li>Medicare rebate applicable with a GPCCMP referral. You pay the fee on the day and the rebate is claimed back for you.</li>
  </ul>

  <h2>Private health</h2>
  <p>Many extras policies include dietetics. Check with your fund for your cover level. You cannot claim both Medicare and private health on the same consultation.</p>

  <h2 id="payment">Payment, cancellations and refunds</h2>
  <ul>
    <li>Consultations are GST-free because dietetics is a health service.</li>
    <li>Consultations are paid on the day. Programs can be paid in full or in instalments.</li>
    <li>Reschedule or cancel free of charge up to 24 hours before your appointment. Inside 24 hours the fee is retained.</li>
    <li>Program appointments can be used within 12 months of purchase.</li>
  </ul>
</Article>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .jump { display: flex; flex-wrap: wrap; gap: .4rem .5rem; margin: 0 0 1rem; }
  .jump a { font-size: .88rem; text-decoration: none; border: 1px solid var(--line); border-radius: 999px; padding: .35rem .75rem; color: var(--heading); }
  .jump a:hover { background: var(--mint); }
  .journey { display: flex; flex-wrap: wrap; gap: .4rem .6rem; align-items: center; font-weight: 600; color: var(--heading); margin: 0 0 1.2rem; }
  .journey span[aria-hidden] { color: var(--fg-soft); }
  .cmp-h { margin-top: 2rem; }

  /* Break out of the 68ch article column */
  .starters, .programs, .table-wrap { width: min(1100px, calc(100vw - 40px)); position: relative; left: 50%; transform: translateX(-50%); }
  @media (max-width: 759px) { .starters, .programs, .table-wrap { width: auto; left: auto; transform: none; } }

  .starters { display: grid; gap: 1rem; margin: .6rem 0 1.2rem; align-items: start; }
  @media (min-width: 760px) { .starters { align-items: stretch; } }
  @media (min-width: 760px) { .starters { grid-template-columns: repeat(2, 1fr); } }
  .starter { background: var(--mint); border-radius: 22px; padding: 1.4rem 1.3rem; display: flex; flex-direction: column; gap: .8rem; }
  .starter .q { margin: 0; font-weight: 600; color: var(--heading); font-size: 1.05rem; }
  .tag { display: inline-block; vertical-align: middle; margin-left: .3rem; font-size: .7rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; border: 1px solid var(--heading); color: var(--heading); border-radius: 999px; padding: .1rem .5rem; }
  .card-note { margin: -.3rem 0 0; font-size: .8rem; color: var(--fg-soft); }
  .reassure { margin: 0 0 1.4rem; font-size: .95rem; }
  .flow { margin: .8rem 0 1rem; padding-left: 1.2rem; display: grid; gap: .4rem; }
  .starter h3 { margin: 0; font-size: 1rem; color: var(--fg); }
  .starter dl { margin: 0; display: grid; gap: .55rem; flex: 1; }
  .starter dt { font-size: .78rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--fg-soft); }
  .starter dd { margin: .1rem 0 0; font-size: .95rem; }
  .starter .btn { align-self: start; }
  .starter .btn-coral, .starter .btn-coral:hover { color: #fff; }

  .existing { margin: 0 0 2rem; padding: .9rem 1.1rem; border: 1px solid var(--line); border-radius: 14px; font-size: .95rem; }
  .existing p { margin: 0; }

  .programs { display: grid; gap: 1rem; margin: 1rem 0 1rem; }
  @media (min-width: 760px) { .programs { grid-template-columns: 1fr 1fr; } }
  .program { border: 1.5px solid var(--line); border-radius: 22px; padding: 1.4rem 1.3rem; }
  .program h3 { margin: 0 0 .5rem; }
  .program p + p { margin-top: .6rem; }
  .fine { font-size: .92rem; color: var(--fg-soft); }

  .table-wrap { overflow-x: auto; margin: .4rem 0 2rem; }
  .table-wrap:focus-visible { outline: 3px solid var(--heading); outline-offset: 3px; border-radius: 6px; }
  .scroll-hint { font-size: .85rem; color: var(--fg-soft); margin: .8rem 0 0; }
  @media (min-width: 760px) { .scroll-hint { display: none; } }
  .matrix { width: 100%; min-width: 560px; border-collapse: collapse; font-size: .92rem; }
  .matrix th, .matrix td { padding: .7rem .7rem; border-bottom: 1px solid var(--line); vertical-align: top; text-align: left; }
  .matrix thead th { border-bottom: 2px solid var(--line); color: var(--heading); }
  .matrix .rowhead { font-weight: 600; color: var(--fg); width: 18%; position: sticky; left: 0; background: var(--bg); box-shadow: 1px 0 0 var(--line); z-index: 1; }
</style>
