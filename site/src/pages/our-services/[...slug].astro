---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { serviceSlug, serviceUrl } from '../../lib/content';
import { faqFromMarkdown, faqPage } from '../../lib/schema';
import { pathways, callLink } from '../../data/pathways';

export async function getStaticPaths() {
  const services = await getCollection('services');
  // /our-services/dietitian/, /our-services/menopause-nutrition/ and /our-services/nutrition-for-women-over-60/ have their own pages.
  return services.filter((s) => !['dietitian', 'menopause-nutrition', 'nutrition-for-women-over-60'].includes(serviceSlug(s))).map((service) => ({ params: { slug: serviceSlug(service) }, props: { service, all: services } }));
}
const { service, all } = Astro.props;
const { Content } = await render(service);
const hasBody = (service.body ?? '').trim().length > 0;
const slug = serviceSlug(service);
const faqLd = faqPage(faqFromMarkdown(service.body));
const parentSlug = slug.includes('/') ? slug.slice(0, slug.lastIndexOf('/')) : undefined;
const parent = parentSlug ? all.find((s) => serviceSlug(s) === parentSlug) : undefined;
const pathwayFor: Record<string, { id: string; name: string }> = {
  'nutrition-for-fertility': { id: 'fertility', name: 'fertility' },
  'prenatal-nutrition-and-dietetics': { id: 'fertility', name: 'fertility' },
  'hormones-pregnancy': { id: 'fertility', name: 'fertility' },
  'ivf-nutrition': { id: 'ivf', name: 'IVF' },
  'pregnancy-nutrition-and-dietetics': { id: 'pregnancy', name: 'pregnancy' },
  'pregnancy-weight': { id: 'pregnancy', name: 'pregnancy' },
  'weight-pregnancy': { id: 'pregnancy', name: 'pregnancy' },
  'specialty-diets-during-pregnancy': { id: 'pregnancy', name: 'pregnancy' },
  'gestational-diabetes': { id: 'gdm', name: 'gestational diabetes' },
  'postnatal-nutrition': { id: 'postpartum', name: 'postpartum' },
  'polycystic-ovary-syndrome': { id: 'pmos', name: 'PMOS (PCOS)' },
  'endometriosis': { id: 'endo', name: 'endometriosis' },
};
const leaf = slug.split('/').pop() ?? slug;
const pathway = pathwayFor[leaf];
// At-a-glance card: reuses Kat-approved pathway copy (who, first-consult detail, takeaway). No new claims.
const glanceLeaves = ['nutrition-for-fertility', 'ivf-nutrition', 'pregnancy-nutrition-and-dietetics', 'gestational-diabetes', 'postnatal-nutrition', 'polycystic-ovary-syndrome', 'endometriosis'];
const pw = pathway && glanceLeaves.includes(leaf) ? pathways.find((p) => p.id === pathway.id) : undefined;
const first = pw?.consults[0];
const siblings = all
  .filter((s) => s.id !== service.id && (parentSlug ? serviceSlug(s).startsWith(parentSlug + '/') : serviceSlug(s).startsWith(slug + '/')))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<Article
  title={service.data.title}
  metaTitle={service.data.seoTitle}
  description={service.data.description ?? service.data.title}
  image={service.data.image}
  imageAlt={service.data.imageAlt}
  lede={service.data.description}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Services', href: '/our-services/' },
    ...(parent ? [{ label: parent.data.title, href: serviceUrl(parent) }] : []),
    { label: service.data.title },
  ]}
  ctaHeading="Talk it through with Kat"
  ctaText="A free 15-minute call: bring your concerns and Kat will explain how she could help. Telehealth Australia-wide or in person in Milton, Brisbane. A Medicare rebate may apply with a GP Chronic Condition Management Plan."
  cta="Book a free call"
>
  <Fragment slot="head">
    {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </Fragment>
  {pw && first && (
    <aside class="glance" aria-label="Working with Kat at a glance" style="margin:0 0 2rem;padding:1.2rem 1.4rem;background:var(--mint);border-radius:16px">
      <h2 style="font-size:1.2rem;margin:0 0 .6rem">Working with Kat at a glance</h2>
      <dl style="margin:0;display:grid;gap:.55rem">
        <div><dt style="font-weight:600">Who it is for</dt><dd style="margin:0">{pw.who}</dd></div>
        <div><dt style="font-weight:600">Your first consultation</dt><dd style="margin:0">{first.length.replace('min', 'minutes')} with Kat Ridout, Accredited Practising Dietitian (APD), in person at Milton Village Medical, Brisbane, or by telehealth anywhere in Australia. {first.detail}</dd></div>
        <div><dt style="font-weight:600">What you receive</dt><dd style="margin:0">{first.takeaway}</dd></div>
        <div><dt style="font-weight:600">Alongside your medical care</dt><dd style="margin:0">Kat provides nutrition assessment and advice. Diagnosis, medication and medical treatment stay with your GP, obstetrician or specialist, and with your permission Kat writes to them after your first consultation.</dd></div>
        <div><dt style="font-weight:600">Next step</dt><dd style="margin:0"><a href={callLink(pw)}>Book a free 15-minute call</a> to talk it through, or <a href={`/consultations/#pathway-${pw.id}`}>see the full {pathway.name} pathway</a>.</dd></div>
      </dl>
    </aside>
  )}
  <Content />
  {!hasBody && (
    <p class="empty">Detailed information for this service is being moved across to the new site. Kat is happy to answer questions on a free 15-minute call.</p>
  )}

  <Fragment slot="after-body">
    {pw ? (
      <section class="pw-steps" aria-labelledby="pw-steps-h" style="margin-top:2.4rem;padding:1.2rem 1.4rem;background:var(--mint);border-radius:16px">
        <h2 id="pw-steps-h" style="font-size:1.3rem;margin:0 0 .4rem">How Kat works with you: the {pathway.name} pathway</h2>
        <p style="margin:0 0 .8rem">{pw.story}</p>
        <ol style="margin:0;padding-left:1.2rem;display:grid;gap:.6rem">
          {pw.consults.map((c) => (
            <li><b>{c.when}, {c.length.replace('min', 'minutes')}: {c.title}.</b> {c.detail}{c.takeaway && <> <i>You receive:</i> {c.takeaway}</>}</li>
          ))}
        </ol>
        <p style="margin:.9rem 0 0"><b>Program:</b> {pw.program}</p>
        <p style="margin:.4rem 0 0"><b>Medicare:</b> {pw.medicare}</p>
        <p style="margin:.4rem 0 0">Appointments are in person at Milton Village Medical, Milton, Brisbane, or by telehealth anywhere in Australia. <a href={callLink(pw)} style="font-weight:600">Book a free 15-minute call</a> or <a href={`/consultations/#pathway-${pw.id}`}>compare all pathways</a>.</p>
      </section>
    ) : pathway && (
      <p class="pw-link" style="margin-top:2rem;padding:1rem 1.2rem;background:var(--mint);border-radius:16px">
        <b>How a program unfolds:</b> see the {pathway.name} pathway consult by consult, with Medicare details and what you take away from each visit.
        <a href={`/consultations/#pathway-${pathway.id}`} style="display:block;margin-top:.4rem;font-weight:600">See the {pathway.name} pathway</a>
      </p>
    )}
    {siblings.length > 0 && (
      <div style="margin-top:2.4rem">
        <h2 style="font-size:1.3rem">{parent ? `Also under ${parent.data.title}` : 'In this area'}</h2>
        <ul style="list-style:none;padding:0;margin:.8rem 0 0;display:grid;gap:.5rem">
          {siblings.map((s) => (
            <li><a class="chip" href={serviceUrl(s)}>{s.data.title}</a></li>
          ))}
        </ul>
      </div>
    )}
  </Fragment>
</Article>
