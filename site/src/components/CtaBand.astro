---
import { BOOK_URL } from '../lib/content';
interface Props { heading?: string; text?: string; cta?: string; href?: string }
const {
  heading = 'Not sure where to start?',
  text = 'A free 15-minute call with Kat Ridout, Accredited Practising Dietitian, to talk through what is going on. Kat will listen, explain how she can help and suggest the best next step for you. Telehealth Australia-wide or in person in Brisbane.',
  cta = 'Book a free call',
  href = BOOK_URL,
} = Astro.props;
---
<section class="cta-band">
  <div class="wrap">
    <div class="box rv">
      <div>
        <h2>{heading}</h2>
        <p>{text}</p>
      </div>
      <a class="btn btn-coral" href={href}>{cta}</a>
    </div>
  </div>
</section>
