---
/* Inline booking calendar (Calendly's supported JavaScript embed, widget.js, with resize). Built 17 Nov 2026 so visitors can pick a time
   without leaving the page. The widget loads only when the section nears the viewport.
   Booking-link tags: the stored attribution from GTM tag "krnAttr" (window.krnDecorate) is applied
   first, then the same privacy cleaner as outgoing Calendly links (window.krnCleanBookingLink in
   Base.astro): generic source, medium and campaign only; no click IDs, search terms or page paths.
   The iframe carries data-krn="1" so the GTM tag does not rewrite it with raw values afterwards. */
import { BOOK_URL } from '../lib/content';
interface Props { campaign?: string; medium?: string; heading?: string; id?: string; flush?: boolean }
const { campaign = '', medium = '', heading = 'Book a free 15-minute call', id = 'book', flush = false } = Astro.props;
const fallback = campaign ? `${BOOK_URL}?utm_source=website&utm_medium=${medium}&utm_campaign=${campaign}` : BOOK_URL;
---
<section class:list={['book-inline', { flush }]} id={id} aria-labelledby={`${id}-h`} data-book-inline data-url={BOOK_URL} data-medium={medium} data-campaign={campaign}>
  <div class="book-inline-in">
    <h2 id={`${id}-h`} tabindex="-1">{heading}</h2>
    <p class="book-inline-sub">Kat calls you at the time you book.</p>
    <div class="book-inline-cal" data-book-target>
      <p class="book-inline-load"><a class="btn btn-coral" href={fallback}>See available times</a></p>
    </div>
    <p class="book-inline-alt">Calendar not showing? <a href={fallback}>Open it in a new page</a> or call <a href="tel:1300640104">1300 640 104</a>.</p>
  </div>
</section>

<style is:global>
  .book-inline{margin:2rem 0;padding:1.4rem 1.2rem;background:var(--mint);border-radius:16px;scroll-margin-top:90px}
  .book-inline.flush{margin:0;border-radius:0;padding:2.4rem var(--gr) 2.4rem var(--gl)}
  .book-inline-in{max-width:760px;margin:0 auto}
  .book-inline h2,.prose .book-inline h2{font-size:1.4rem;margin:0 0 .3rem;padding:0;color:var(--heading)}
  .book-inline-sub{margin:0 0 1rem;color:var(--fg)}
  .book-inline-cal{background:var(--bg);border-radius:12px;min-height:120px;overflow:hidden}
  .book-inline-cal.on{min-height:560px}
  .book-inline-cal iframe{width:100%;height:100%;min-height:560px;border:0;display:block}
  .book-inline h2:focus{outline:none}
  .book-inline h2:focus-visible{outline:2px solid var(--sage-deep);outline-offset:4px}
  .book-inline-load{margin:0;padding:2rem 1rem;text-align:center}
  .book-inline-alt{margin:.8rem 0 0;font-size:.9rem;color:var(--fg-soft)}
</style>

<script is:inline>
(function(){
  if (window.krnBookInline) return; window.krnBookInline = true;
  function build(sec){
    var u = new URL(sec.getAttribute('data-url'));
    var camp = sec.getAttribute('data-campaign'), med = sec.getAttribute('data-medium');
    if (camp) { u.searchParams.set('utm_source', 'website'); u.searchParams.set('utm_medium', med || 'website'); u.searchParams.set('utm_campaign', camp); }
    var href = u.toString();
    if (typeof window.krnDecorate === 'function') {
      try { href = window.krnDecorate(href); } catch (e) {}
    } else {
      // GTM not loaded yet or blocked: resolve attribution the same way the GTM tag does
      // (this visit's tags first, then the stored value if under 90 days old). Read only.
      try {
        var q = new URLSearchParams(location.search), at = null;
        var id = q.get('gclid') ? 'gclid.x' : q.get('gbraid') ? 'gbraid.x' : q.get('wbraid') ? 'wbraid.x' : '';
        if (id || q.get('utm_source')) at = { s: q.get('utm_source') || 'google', m: q.get('utm_medium') || (id ? 'cpc' : '(none)'), c: q.get('utm_campaign') || '', id: id };
        if (!at) { var st = JSON.parse(localStorage.getItem('krn_attr') || 'null'); if (st && Date.now() - st.ts <= 7776e6) at = st; }
        if (at) {
          var w = new URL(href);
          w.searchParams.set('utm_source', String(at.s).slice(0, 60)); w.searchParams.set('utm_medium', String(at.m).slice(0, 30));
          if (at.c) w.searchParams.set('utm_campaign', at.c); else if (at.id || /^(cpc|ppc|paid)$/.test(at.m)) w.searchParams.set('utm_campaign', 'ads-unknown');
          w.searchParams.set('utm_content', at.id || 'page');
          href = w.toString();
        }
      } catch (e) {}
    }
    try { if (typeof window.krnCleanBookingLink === 'function') href = window.krnCleanBookingLink(href); } catch (e) {}
    u = new URL(href);
    // Mark bookings made in the on-page calendar (generic value, no path): page-service -> inline-service.
    var c = u.searchParams.get('utm_content') || '';
    if (c !== 'ads-click') u.searchParams.set('utm_content', c.indexOf('page-') === 0 ? c.replace('page-', 'inline-') : 'inline');
    u.searchParams.set('hide_gdpr_banner', '1');
    u.searchParams.set('hide_event_type_details', '1');
    return u.toString();
  }
  var WIDGET = 'https://assets.calendly.com/assets/external/widget.js', pending = null;
  function widget(cb){
    if (window.Calendly && window.Calendly.initInlineWidget) return cb(true);
    if (pending) return pending.push(cb);
    pending = [cb];
    var sc = document.createElement('script'); sc.src = WIDGET; sc.async = true;
    var done = function(ok){ var q = pending; pending = null; q.forEach(function(f){ f(ok && !!(window.Calendly && window.Calendly.initInlineWidget)); }); };
    sc.onload = function(){ done(true); }; sc.onerror = function(){ done(false); };
    document.head.appendChild(sc);
  }
  function load(sec){
    if (sec.krnLoaded) return; sec.krnLoaded = true;
    var box = sec.querySelector('[data-book-target]');
    widget(function(ok){
      if (!ok) return; // script blocked: the "See available times" link stays as the way to book
      box.classList.add('on');
      var want = new URL(build(sec));
      window.Calendly.initInlineWidget({ url: want.toString(), parentElement: box, resize: true });
      var f = box.querySelector('iframe');
      if (f) {
        f.setAttribute('data-krn', '1'); // stops the GTM tag rewriting the frame with raw click IDs
        // widget.js copies utm_* from the page address into the frame. Force the sanitised values back.
        try {
          var got = new URL(f.src);
          ['utm_source','utm_medium','utm_campaign','utm_content','utm_term'].forEach(function(k){
            if (want.searchParams.has(k)) got.searchParams.set(k, want.searchParams.get(k)); else got.searchParams.delete(k);
          });
          if (got.toString() !== f.src) f.src = got.toString();
        } catch (e) {}
        f.title = 'Book a free 15-minute call with Kat';
        f.addEventListener('load', function(){ var l = box.querySelector('.book-inline-load'); if (l) l.remove(); });
      }
      (window.dataLayer = window.dataLayer || []).push({ event: 'krn_calendar_shown' });
    });
  }
  var secs = [].slice.call(document.querySelectorAll('[data-book-inline]'));
  if (!secs.length) return;
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(es){ es.forEach(function(e){ if (e.isIntersecting) { load(e.target); io.unobserve(e.target); } }); }, { rootMargin: '600px 0px' });
    secs.forEach(function(s){ io.observe(s); });
  } else { secs.forEach(load); }
  // Any on-page "book" button that points at an inline calendar loads it straight away.
  document.addEventListener('click', function(ev){
    var a = ev.target; while (a && a.tagName !== 'A') a = a.parentElement;
    if (!a) return; var h = a.getAttribute('href') || '';
    if (h.charAt(0) === '#' && h.length > 1) { var t = document.getElementById(h.slice(1)); if (t && t.hasAttribute('data-book-inline')) { load(t); var hd = t.querySelector('h2'); if (hd) setTimeout(function(){ hd.focus({ preventScroll: true }); }, 50); } }
  });
  // Messages from the calendar: only from calendly.com, only the two expected events.
  // Tracking sends the event name alone; nothing from the booking payload is read or forwarded.
  var MAP = { 'calendly.date_and_time_selected': 'krn_calendar_time_selected', 'calendly.event_scheduled': 'krn_calendly_booked' };
  window.addEventListener('message', function(e){
    if (!/^https:\/\/([a-z0-9-]+\.)?calendly\.com$/.test(e.origin)) return;
    var d = e.data; if (!d || typeof d.event !== 'string') return;
    if (MAP[d.event]) (window.dataLayer = window.dataLayer || []).push({ event: MAP[d.event] });
  });
  // Completed booking. If Calendly redirects to the thank-you page, that page records it; if it
  // stays here, record it after a short wait. Either way krnBookingComplete counts it once.
  window.addEventListener('message', function(e){
    if (!/^https:\/\/([a-z0-9-]+\.)?calendly\.com$/.test(e.origin)) return;
    if (e.data && e.data.event === 'calendly.event_scheduled') setTimeout(function(){ if (typeof window.krnBookingComplete === 'function') window.krnBookingComplete('inline'); }, 4000);
  });
  // Phone bottom bar: on pages with an on-page calendar the bar's button scrolls to it, and the
  // bar slides away while the calendar is on screen so it never covers the times or the form.
  function bar(){
    var b = document.getElementById('bookbar'); if (!b) return;
    var a = b.querySelector('a'); if (a && secs[0].id) a.setAttribute('href', '#' + secs[0].id);
    if (!('IntersectionObserver' in window)) return;
    var vis = new Set();
    var bo = new IntersectionObserver(function(es){ es.forEach(function(en){ if (en.isIntersecting) vis.add(en.target); else vis.delete(en.target); }); b.classList.toggle('over-cal', vis.size > 0); });
    secs.forEach(function(s){ bo.observe(s); });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bar); else bar();
})();
</script>
