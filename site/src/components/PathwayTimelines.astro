---
/* Pathway timelines: CSS-only radio tabs, one timeline per pathway. Data in src/data/pathways.ts (Kat gate). */
import { pathways, callLink } from '../data/pathways';
const defaultId = '';
---
<div class="pw" id="pathway-picker">
  <p class="pw-label" id="pw-label">Where are you right now?</p>
  <div class="pw-tabs" role="radiogroup" aria-labelledby="pw-label">
    {pathways.map((p) => (
      <label class="pw-tab">
        <input type="radio" name="pathway" value={p.id} checked={p.id === defaultId} data-pathway={p.id} />
        <span>{p.tab}</span>
      </label>
    ))}
  </div>

  <p class="pw-empty">Choose a situation above to see a summary.</p>
  <p class="sr" role="status" aria-live="polite" id="pw-status"></p>
  {pathways.map((p) => (
    <section class={`pw-panel pw-${p.id}`} aria-labelledby={`pwh-${p.id}`}>
      <header class="pw-head">
        <h3 id={`pwh-${p.id}`}>{p.name}</h3>
        <p class="pw-who">{p.who}</p>
        <p class="pw-story">{p.story}</p>
      </header>
      <details class="sched">
        <summary>See an example appointment schedule ({p.consults.length} appointments)</summary>
      <ol class={`tl tl-${p.consults.length}`}>
        {p.consults.map((c, i) => (
          <>
          {c.phase && <li class="tl-phase" aria-hidden="true">{c.phase}</li>}
          <li class={`tl-item ${((i + 1) % 4 === 0 && p.consults.length === 8) || i === p.consults.length - 1 ? 'tl-rowend' : ''}`}>
            <div class="tl-marker"><span class="tl-n">{i + 1}</span></div>
            <div class="tl-body">
              <p class="tl-when">{c.when} <small>{c.length}</small></p>
              <h4>{c.title}</h4>
              <p class="tl-detail">{c.detail}</p>
              {c.takeaway && <p class="tl-take"><b>You take away:</b> {c.takeaway}</p>}
            </div>
          </li>
          </>
        ))}
      </ol>
      </details>

      <div class="pw-foot">
        <p><b>Program:</b> {p.program}</p>
        <p><b>Medicare:</b> {p.medicare}</p>
        <p class="pw-note">An example of the topics usually covered. Timing and content are individualised to you, and appointments are booked as you go.</p>
        <a class="btn btn-coral" href={callLink(p)}>Book a free call about the {p.tab.toLowerCase()} pathway</a>
      </div>
    </section>
  ))}
</div>

<style>
  .pw { margin: 1rem 0 2rem; }
  @media (min-width: 900px) { .pw { width: min(1100px, calc(100vw - 40px)); position: relative; left: 50%; transform: translateX(-50%); } }
  .pw-label { font-weight: 600; color: var(--heading); margin: 0 0 .5rem; }
  .sched { margin: 0 0 .5rem; }
  .sched summary { cursor: pointer; font-weight: 600; color: var(--heading); padding: .6rem 0; }
  .sched[open] summary { margin-bottom: .8rem; }
  .pw-tabs { display: flex; flex-wrap: wrap; gap: .45rem; margin-bottom: 1.4rem; }
  .pw-tab { position: relative; }
  .pw-tab input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .pw-tab span { display: inline-block; padding: .5rem .9rem; border-radius: 999px; border: 1px solid var(--line); font-size: .92rem; background: var(--bg); color: var(--fg); }
  .pw-tab input:checked + span { background: var(--heading); color: var(--bg); border-color: var(--heading); }
  .pw-tab input:focus-visible + span { outline: 2px solid var(--heading); outline-offset: 2px; }

  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .pw-panel { display: none; }
  .pw[data-active="fertility"] .pw-fertility, .pw[data-active="ivf"] .pw-ivf, .pw[data-active="pregnancy"] .pw-pregnancy,
  .pw[data-active="gdm"] .pw-gdm, .pw[data-active="postpartum"] .pw-postpartum, .pw[data-active="pmos"] .pw-pmos,
  .pw[data-active="endo"] .pw-endo { display: block; }
  @supports not selector(:has(*)) { .pw:not([data-active]) .pw-panel { display: block; } .pw:not([data-active]) .pw-empty { display: none; } }
  @media print { .pw-tabs, .pw-label, .pw-empty { display: none !important; } .pw-panel { display: block !important; break-inside: avoid; } }
  .pw-tab input:focus-visible + span { outline: 3px solid var(--heading); outline-offset: 2px; }
  .pw-empty { color: var(--fg-soft); font-size: .92rem; margin: 0; }
  .pw:has(input[name="pathway"]:checked) .pw-empty { display: none; }
  .pw:has(input[value="fertility"]:checked) .pw-fertility,
  .pw:has(input[value="ivf"]:checked) .pw-ivf,
  .pw:has(input[value="pregnancy"]:checked) .pw-pregnancy,
  .pw:has(input[value="gdm"]:checked) .pw-gdm,
  .pw:has(input[value="postpartum"]:checked) .pw-postpartum,
  .pw:has(input[value="pmos"]:checked) .pw-pmos,
  .pw:has(input[value="endo"]:checked) .pw-endo { display: block; }

  .pw-head h3 { margin: 0 0 .3rem; }
  .pw-who { margin: 0 0 .4rem; color: var(--fg); }
  .pw-story { margin: 0 0 1.2rem; color: var(--fg-soft); font-size: .95rem; }

  /* Timeline: vertical rail by default */
  .tl { list-style: none; margin: 0; padding: 0; position: relative; }
  .tl-item { display: grid; grid-template-columns: 2.2rem 1fr; gap: .8rem; position: relative; padding-bottom: 1.3rem; }
  .tl-item::before { content: ""; position: absolute; left: 1.05rem; top: 2.2rem; bottom: 0; width: 2px; background: var(--line); }
  .tl-item:last-child::before { display: none; }
  .tl-phase { display: none; }
  .tl-marker { display: flex; align-items: flex-start; justify-content: center; }
  .tl-n { display: inline-grid; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 50%; background: var(--heading); color: var(--bg); font-weight: 600; font-size: .95rem; }
  .tl-when { margin: .2rem 0 .1rem; font-size: .85rem; color: var(--fg-soft); font-weight: 600; letter-spacing: .01em; }
  .tl-when small { font-weight: 400; margin-left: .35rem; }
  .tl-body h4 { margin: 0 0 .25rem; font-size: 1.05rem; color: var(--heading); }
  .tl-detail { margin: 0; font-size: .95rem; }
  .tl-take { margin: .45rem 0 0; font-size: .88rem; color: var(--fg-soft); background: var(--mint); border-radius: 12px; padding: .5rem .7rem; }

  /* Desktop: horizontal rail for 5-step pathways; 8 steps wrap to two rows of 4 */
  @media (min-width: 900px) {
    .tl { display: grid; gap: 1.2rem 1rem; }
    .tl-5 { grid-template-columns: repeat(5, 1fr); }
    .tl-8 { grid-template-columns: repeat(4, 1fr); }
    .tl-item { grid-template-columns: 1fr; grid-template-rows: auto 1fr; align-content: start; gap: .5rem; padding-bottom: 0; }
    .tl-item::before { left: 2.1rem; right: -1rem; top: 1.05rem; bottom: auto; height: 2px; width: auto; }
    .tl-item.tl-rowend::before { display: none; }
    .tl-phase { display: block; grid-column: 1 / -1; font-size: .8rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--fg-soft); margin: .4rem 0 -.4rem; }
    .tl-marker { justify-content: flex-start; }
  }

  .pw-foot { margin-top: 1.4rem; padding-top: 1rem; border-top: 1px solid var(--line); display: grid; gap: .5rem; }
  .pw-foot p { margin: 0; font-size: .95rem; }
  .pw-note { color: var(--fg-soft); font-size: .88rem; }
  .pw-foot .btn { justify-self: start; margin-top: .4rem; }
  .pw-foot .btn-coral, .pw-foot .btn-coral:hover { color: #fff; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.pw');
  const status = document.getElementById('pw-status');
  const radios = Array.from(document.querySelectorAll<HTMLInputElement>('.pw input[name="pathway"]'));
  const select = (id: string, announce: boolean) => {
    if (!root) return;
    root.dataset.active = id;
    const h = document.getElementById(`pwh-${id}`);
    if (announce && status && h) status.textContent = `Showing ${h.textContent}`;
  };
  // Deep links from service pages: #pathway-<id> (preferred, not sent to analytics) or legacy ?pathway=<id>
  const fromHash = location.hash.startsWith('#pathway-') ? location.hash.slice(9) : '';
  const want = fromHash || new URLSearchParams(location.search).get('pathway') || '';
  if (want) {
    const r = radios.find((x) => x.value === want);
    if (r) {
      r.checked = true; select(want, false);
      const d = document.querySelector<HTMLDetailsElement>(`.pw-${CSS.escape(want)} details`); if (d) d.open = true;
      document.getElementById('pathways')?.scrollIntoView();
    }
  }
  radios.forEach((el) => el.addEventListener('change', () => {
    select(el.value, true);
    // Generic event only: no condition name is sent to analytics.
    (window as any).dataLayer = (window as any).dataLayer || [];
    (window as any).dataLayer.push({ event: 'pathway_tab' });
  }));
  // Print: show every example in full.
  window.addEventListener('beforeprint', () => document.querySelectorAll<HTMLDetailsElement>('.pw details').forEach((d) => (d.open = true)));
</script>
