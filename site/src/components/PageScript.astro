---
/* Shared inline script for sub-pages: reveal-on-scroll, book bar, and hiding images that fail to load. */
---
<script is:inline>
(function(){
  document.documentElement.classList.add('js');
  var bar=document.getElementById('bookbar');
  if(bar){ var onScroll=function(){ bar.classList.toggle('show',window.scrollY>480); }; window.addEventListener('scroll',onScroll,{passive:true}); onScroll(); }
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target);} }); },{rootMargin:'0px 0px -8% 0px',threshold:.1});
    document.querySelectorAll('.rv').forEach(function(el){ io.observe(el); });
  } else { document.querySelectorAll('.rv').forEach(function(el){ el.classList.add('in'); }); }
  function gone(img){
    img.classList.add('missing');
    var fig=img.closest('.pfig, figure, .thumb');
    if(fig) fig.classList.add('missing');
  }
  function watch(img){
    if(img.complete && img.naturalWidth===0 && img.getAttribute('src')) gone(img);
    img.addEventListener('error',function(){ gone(img); });
  }
  document.querySelectorAll('.prose img, .pfig img, .thumb img').forEach(watch);
})();
</script>
