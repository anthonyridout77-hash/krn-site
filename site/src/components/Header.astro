<script is:inline>
(function(){
  var m=document.querySelector('details.menu'); if(!m) return;
  var s=m.querySelector('summary');
  function sync(){ s.setAttribute('aria-expanded', m.open?'true':'false'); }
  m.addEventListener('toggle',sync); sync();
  m.addEventListener('click',function(e){ if(e.target.closest('a')) m.removeAttribute('open'); });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape'&&m.open){ m.removeAttribute('open'); s.focus(); } });
  document.addEventListener('click',function(e){ if(m.open&&!m.contains(e.target)) m.removeAttribute('open'); });
})();
</script>
