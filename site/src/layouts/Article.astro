---
/* Shared article layout for blog posts, recipes and service pages. */
import Base from './Base.astro';
import BookBar from '../components/BookBar.astro';
import CtaBand from '../components/CtaBand.astro';
import PageScript from '../components/PageScript.astro';
import '../styles/article.css';
import { formatDate, isoDate } from '../lib/content';

interface Crumb { label: string; href?: string }
interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  date?: Date;
  updated?: Date;
  category?: string;
  categoryHref?: string;
  crumbs?: Crumb[];
  lede?: string;
  ctaHeading?: string;
  ctaText?: string;
  cta?: string;
}
const {
  title, description, image, imageAlt = '', date, updated, category, categoryHref,
  crumbs = [], lede, ctaHeading, ctaText, cta,
} = Astro.props;
const showUpdated = updated && date && updated.getTime() - date.getTime() > 86400000;
---
<Base title={`${title} | Katrina Ridout Nutrition`} description={description} image={image}>
  <Fragment slot="head">
    {date && <meta property="article:published_time" content={isoDate(date)} />}
    {updated && <meta property="article:modified_time" content={isoDate(updated)} />}
  </Fragment>

  <section class="phero">
    <div class="wrap">
      {crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          {crumbs.map((c, i) => (
            <>
              {i > 0 && <span aria-hidden="true">/</span>}
              {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
            </>
          ))}
        </nav>
      )}
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      {(date || category) && (
        <div class="meta">
          {category && (categoryHref ? <a class="cat" href={categoryHref}>{category}</a> : <span class="cat">{category}</span>)}
          {date && <time datetime={isoDate(date)}>{formatDate(date)}</time>}
          {showUpdated && <span>Updated {formatDate(updated)}</span>}
        </div>
      )}
    </div>
  </section>

  {image && (
    <figure class="pfig">
      <div class="wrap">
        <img src={image} alt={imageAlt} width="1200" height="675" decoding="async" fetchpriority="high" />
      </div>
    </figure>
  )}

  <article class="article">
    <div class="wrap">
      <div class="prose">
        <slot />
      </div>
      <slot name="after-body" />
    </div>
  </article>

  <CtaBand heading={ctaHeading} text={ctaText} cta={cta} />

  <slot name="related" />

  <BookBar slot="after" />
  <PageScript slot="after" />
</Base>
