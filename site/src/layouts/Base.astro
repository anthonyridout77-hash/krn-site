---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BASE_GRAPH } from '../lib/schema';
interface Props { title: string; description: string; image?: string; noindex?: boolean }
const { title: rawTitle, description: rawDesc, image = '/images/kat-ridout-apd.jpg', noindex = false } = Astro.props;
const SUFFIX = ' | Katrina Ridout Nutrition';
const cutWords = (t: string, max: number) => { const c = t.slice(0, max); const i = c.lastIndexOf(' '); return (i > max * 0.6 ? c.slice(0, i) : c).replace(/[\s,;:|-]+$/, '') + '…'; };
const fitTitle = (t: string) => {
  if (t.length <= 65) return t;
  const core = t.endsWith(SUFFIX) ? t.slice(0, -SUFFIX.length) : t;
  if (core.length + 13 <= 65) return core + ' | Kat Ridout';
  if (core.length <= 65) return core;
  return cutWords(core, 63);
};
const fitDesc = (d: string) => {
  if (d.length <= 160) return d;
  const c = d.slice(0, 160); const end = Math.max(c.lastIndexOf('. '), c.lastIndexOf('.'));
  if (end > 90) return c.slice(0, end + 1);
  return cutWords(d, 157);
};
const title = fitTitle(rawTitle);
const description = fitDesc(rawDesc);
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL(image, Astro.site)}>
  <meta property="og:url" content={canonical}>
  <meta name="theme-color" content="#FFFFFF">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script type="application/ld+json" set:html={JSON.stringify(BASE_GRAPH)} />
  <slot name="head" />
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-NVQZKHL');</script>
  <!-- End Google Tag Manager -->
</head>
<body class="js">
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NVQZKHL"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <Header />
  <main id="main">
  <slot />
  </main>
  <Footer />
  <slot name="after" />
  <script is:inline>
  /* Privacy: GTM tag "krnAttr" writes utm_content=page<path> into Calendly links on click
     (capture phase). This bubble-phase listener runs after it, before navigation, and replaces
     the path with a generic page type so no condition-specific page reaches Calendly.
     It also drops utm_term (could hold a search phrase). Click IDs and source/medium are kept. */
  (function(){
    function pageType(p){
      if (p === '/' ) return 'home';
      if (/^\/our-services\//.test(p)) return 'service';
      if (/^\/(blogs|recipes-for-pregnancy)\//.test(p)) return 'blog';
      if (/^\/(consultations|contact-us|thank-you|refer-your-patients)\//.test(p)) return 'consult';
      if (/^\/(fertility-pregnancy-dietitian-[a-z-]+|pregnancy-dietitian-adelaide)\//.test(p)) return 'city';
      return 'other';
    }
    function clean(href){
      try {
        var u = new URL(href);
        if (!/(^|\.)calendly\.com$/.test(u.hostname)) return href;
        var c = u.searchParams.get('utm_content') || '';
        if (!/^(gclid|gbraid|wbraid)\./.test(c)) u.searchParams.set('utm_content', 'page-' + pageType(location.pathname));
        u.searchParams.delete('utm_term');
        return u.toString();
      } catch (e) { return href; }
    }
    window.krnCleanBookingLink = clean;
    document.addEventListener('click', function(ev){
      var a = ev.target; while (a && a.tagName !== 'A') a = a.parentElement;
      if (a && a.href && a.href.indexOf('calendly.com') > -1) a.href = clean(a.href);
    }, false);
  })();
  </script>
</body>
</html>
